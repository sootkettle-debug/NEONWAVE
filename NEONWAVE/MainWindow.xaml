<Window x:Class="NEONWAVE.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NEONWAVE" Width="1040" Height="720" MinWidth="780" MinHeight="560"
 Background="#090914" Foreground="#F4F5FF" WindowStartupLocation="CenterScreen"
 AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
 KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#0C0D1B"/><Setter Property="Foreground" Value="#E9E9FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="#121326"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#36F5FF"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EDEBFF"/>
   <Setter Property="Background" Value="#25203B"/>
   <Setter Property="BorderBrush" Value="#55406F"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,7"/>
   <Setter Property="Margin" Value="3,0"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.Background>
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0A0B18" Offset="0"/>
    <GradientStop Color="#171027" Offset="0.48"/>
    <GradientStop Color="#10172A" Offset="1"/>
   </LinearGradientBrush>
  </Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="N E O N W A V E" FontSize="27" FontWeight="Bold" Foreground="#36F5FF"/>
    <TextBlock Text="S Y N T H W A V E   A U D I O   S Y S T E M" FontSize="10" Foreground="#8586A8" Margin="2,4,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" Width="62" Height="62" CornerRadius="31" HorizontalAlignment="Center" VerticalAlignment="Center"
           BorderThickness="2" BorderBrush="#FF4BD8" Background="#17132D">
    <Border.Effect>
     <DropShadowEffect Color="#FF32D2" BlurRadius="24" ShadowDepth="0" Opacity="0.9"/>
    </Border.Effect>
    <Border CornerRadius="29" Margin="3" BorderThickness="1" BorderBrush="#54F7FF">
     <Border.Background>
      <RadialGradientBrush>
       <GradientStop Color="#4B1F68" Offset="0"/>
       <GradientStop Color="#201A49" Offset="0.58"/>
       <GradientStop Color="#10172C" Offset="1"/>
      </RadialGradientBrush>
     </Border.Background>
     <Border.Effect>
      <DropShadowEffect Color="#36F5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.75"/>
     </Border.Effect>
     <Viewbox Margin="8">
      <TextBlock Text="♫" FontFamily="Segoe UI Symbol" FontWeight="Bold" Foreground="#FFFFFF">
       <TextBlock.Effect>
        <DropShadowEffect Color="#36F5FF" BlurRadius="13" ShadowDepth="0" Opacity="1"/>
       </TextBlock.Effect>
      </TextBlock>
     </Viewbox>
    </Border>
   </Border>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="●" Foreground="#FF3BC8" FontSize="12" VerticalAlignment="Center"/>
    <TextBlock Text="  AUDIO CORE ONLINE" Foreground="#A7A8C5" FontSize="10" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#17152A" BorderBrush="#493052" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <StackPanel>
      <TextBlock Text="NOW TRANSMITTING" Foreground="#FF3BC8" FontSize="10" FontWeight="Bold"/>
      <TextBlock x:Name="TrackTitle" Text="No track loaded" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
      <TextBlock x:Name="TrackInfo" Text="Add an audio folder or drop music files here" Foreground="#8586A8" FontSize="11" Margin="0,3,0,0"/>
     </StackPanel>
     <Border HorizontalAlignment="Right" Width="76" Height="76" CornerRadius="10" Background="#1C1D36" BorderBrush="#36F5FF" BorderThickness="1">
      <Viewbox><TextBlock Text="♫" Foreground="#36F5FF" FontSize="44"/></Viewbox>
     </Border>
    </Grid>
    <Grid Grid.Row="1" Margin="0,14,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#8586A8" FontSize="10" VerticalAlignment="Center"/>
     <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Margin="12,0" VerticalAlignment="Center" ValueChanged="SeekSlider_ValueChanged" PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>
     <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="#8586A8" FontSize="10" VerticalAlignment="Center"/>
    </Grid>
   </Grid>
  </Border>
  <Border Grid.Row="2" Background="#141629" BorderBrush="#34304F" BorderThickness="1" CornerRadius="12" Padding="14">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10">
     <TextBlock Text="PLAY QUEUE" FontWeight="Bold" FontSize="12" Foreground="#36F5FF" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
      <Button Content="+ ADD FILES" Click="Add_Click" FontSize="10"/>
      <Button Content="ADD FOLDER" Click="AddFolder_Click" FontSize="10"/>
      <Button Content="REMOVE" Click="Remove_Click" FontSize="10"/>
      <Button Content="CLEAR" Click="Clear_Click" FontSize="10"/>
      <Button Content="SAVE" Click="SavePlaylist_Click" FontSize="10"/>
      <Button Content="LOAD" Click="LoadPlaylist_Click" FontSize="10"/>
     </StackPanel>
    </DockPanel>
    <ListBox x:Name="Playlist" Grid.Row="1" SelectionChanged="Playlist_SelectionChanged" MouseDoubleClick="Playlist_MouseDoubleClick" DisplayMemberPath="DisplayName"/>
    <TextBlock Grid.Row="2" x:Name="QueueCount" Text="0 TRACKS  •  DROP FILES OR FOLDERS TO ADD" Foreground="#8586A8" FontSize="9" Margin="3,10,0,0"/>
   </Grid>
  </Border>
  <Border Grid.Row="3" Background="#17152A" BorderBrush="#493052" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,14,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <TextBlock Text="NEONWAVE  •  READY TO PLAY" Foreground="#77799E" FontSize="9" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
     <Button Content="|◀" Click="Previous_Click" FontSize="16" Width="48"/>
     <Button x:Name="PlayButton" Content="▶" Click="Play_Click" FontSize="20" Width="64" Background="#24264A" BorderBrush="#36F5FF"/>
     <Button Content="■" Click="Stop_Click" FontSize="16" Width="48"/>
     <Button Content="▶|" Click="Next_Click" FontSize="16" Width="48"/>
    </StackPanel>
    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock x:Name="VolumeText" Text="80%" Foreground="#36F5FF" FontSize="10" HorizontalAlignment="Right"/>
     <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" Width="120" ValueChanged="VolumeSlider_ValueChanged"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>