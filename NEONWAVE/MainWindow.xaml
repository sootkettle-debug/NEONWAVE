<Window x:Class="NEONWAVE.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DARKWAVE" Width="1040" Height="720" MinWidth="840" MinHeight="560"
 Background="#080A0D" Foreground="#DDE5E5" WindowStartupLocation="CenterScreen"
 AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
 KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#0B0E11"/><Setter Property="Foreground" Value="#D5DEDF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="#171B1F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#30383D"/><Setter Property="Foreground" Value="#D5E5D8"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="13"/><Setter Property="Background" Value="#090C0F"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="#090C0F" Width="13">
     <Border Margin="3,2" CornerRadius="0" Background="#11171A" BorderBrush="#303B40" BorderThickness="1"/>
     <Track x:Name="PART_Track" IsDirectionReversed="True">
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="1,1" CornerRadius="0" BorderBrush="#A8B9B2" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#84978E" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/></Border.Effect><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#151C1E" Offset="0"/><GradientStop Color="#263238" Offset="0.5"/><GradientStop Color="#1B2528" Offset="1"/></LinearGradientBrush></Border.Background></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Foreground" Value="#263238"/><Setter Property="Background" Value="#11171A"/><Setter Property="Height" Value="20"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid VerticalAlignment="Center" Height="20"><Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False" Height="5" VerticalAlignment="Center" Background="#263238" BorderThickness="0"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="0"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="13" Height="13" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#1B2528" BorderBrush="#A8B9B2" BorderThickness="1" CornerRadius="0"><Border.Effect><DropShadowEffect Color="#84978E" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/></Border.Effect></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False" Height="5" VerticalAlignment="Center" Background="#11171A" BorderThickness="0"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="0"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="#252C2F"/><Setter Property="BorderBrush" Value="#748084"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,6"/><Setter Property="FontSize" Value="9"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Margin" Value="3,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Face" CornerRadius="9" BorderThickness="1" BorderBrush="#748084"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#566164" Offset="0"/><GradientStop Color="#343E41" Offset="0.18"/><GradientStop Color="#171D20" Offset="0.52"/><GradientStop Color="#30393C" Offset="1"/></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="2" Opacity="0.85"/></Border.Effect></Border><Border Margin="2" CornerRadius="7" BorderThickness="1" BorderBrush="#263034" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#C4D0C9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="22,22,22,14">
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#30383B" Offset="0"/><GradientStop Color="#121719" Offset="0.12"/><GradientStop Color="#080B0D" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="LibraryRow" Height="*"/></Grid.RowDefinitions>
  <Border x:Name="LogoGlow" Visibility="Collapsed" Width="0" Height="0"/>
  <Border Grid.Row="0" Background="#20272A" BorderBrush="#657176" BorderThickness="1" CornerRadius="4" Padding="16,4,16,16" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><StackPanel Margin="0,15,0,0"><TextBlock Text="NOW PLAYING" Foreground="#B6C9BA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TrackTitle" Text="No track loaded" Foreground="#62696B" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="TrackInfo" Text="Add an audio folder or drop music files here" Foreground="#9AA8A4" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
 <Border Width="62" Height="62" CornerRadius="31" Margin="0,0,10,0" BorderThickness="1" BorderBrush="#485257">
  <Border.Background><RadialGradientBrush><GradientStop Color="#252B2D" Offset="0"/><GradientStop Color="#111719" Offset="0.72"/><GradientStop Color="#050708" Offset="1"/></RadialGradientBrush></Border.Background>
  <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="7" ShadowDepth="2" Opacity="0.85"/></Border.Effect>
  <Grid Margin="9">
   <Path Data="M 36,8 A 19,19 0 1 0 36,42 A 14,17 0 1 1 36,8 Z" Fill="#080B0C" Stroke="#3B4446" StrokeThickness="1.1" StrokeLineJoin="Round"/>
   <Path Data="M 5,32 C 11,27 16,27 21,31 C 25,34 28,35 32,31 C 35,28 39,24 44,25 C 40,29 40,33 36,37 C 32,41 27,42 22,39 C 17,36 12,35 5,38 Z" Fill="#080B0C" Stroke="#414A4C" StrokeThickness="1.1" StrokeLineJoin="Round"/>
   <Path Data="M 5,32 C 11,27 16,27 21,31 C 25,34 28,35 32,31 C 35,28 39,24 44,25" Fill="Transparent" Stroke="#586164" StrokeThickness="0.9"/>
  </Grid>
 </Border>
 <Border Width="76" Height="76" CornerRadius="3" Background="#0B1012" BorderBrush="#C7D8C7" BorderThickness="1"><Viewbox><TextBlock Text="♫" Foreground="#C7D8C7" FontSize="44"/></Viewbox></Border>
</StackPanel><TextBlock Text="DARKWAVE" FontFamily="pack://application:,,,/Fonts/#Pirata One" FontSize="25" FontWeight="Normal" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" IsHitTestVisible="False"/></Grid><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#9AA8A4" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Margin="12,0" VerticalAlignment="Center" Foreground="#263238" Background="#11171A" ValueChanged="SeekSlider_ValueChanged" PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="#9AA8A4" FontSize="10" VerticalAlignment="Center"/></Grid><Border x:Name="PlaybackControlsPanel" Grid.Row="2" Background="#171D20" BorderBrush="#485257" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ReadyStatusText" Text="DARKWAVE  •  READY TO PLAY" Foreground="#8B9995" FontSize="9" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="|◀" Click="Previous_Click" FontSize="9" Width="78"/><Button x:Name="PlayButton" Content="▶" Click="Play_Click" FontSize="9" Width="78" Background="#24264A"/><Button Content="■" Click="Stop_Click" FontSize="9" Width="78"/><Button Content="▶|" Click="Next_Click" FontSize="9" Width="78"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"><Button Click="AccentGreen_Click" Width="24" Height="24" Padding="0" Margin="2,0" ToolTip="Green accent"><Border Width="8" Height="8" CornerRadius="4" Background="#00B84C"/></Button><Button Click="AccentOrange_Click" Width="24" Height="24" Padding="0" Margin="2,0" ToolTip="Orange accent"><Border Width="8" Height="8" CornerRadius="4" Background="#FF8A00"/></Button><Button Click="AccentBlue_Click" Width="24" Height="24" Padding="0" Margin="2,0" ToolTip="Blue accent"><Border Width="8" Height="8" CornerRadius="4" Background="#268BFF"/></Button></StackPanel><StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="VolumeText" Text="80%" Foreground="#C7D8C7" FontSize="10" HorizontalAlignment="Right"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" Width="120" ValueChanged="VolumeSlider_ValueChanged"/></StackPanel></Grid></Border></Grid></Border>
  <Border x:Name="MusicLibraryPanel" Grid.Row="1" Background="#171D20" BorderBrush="#485257" BorderThickness="1" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel x:Name="LibraryHeader" Margin="0,0,0,10"><TextBlock x:Name="LibraryTitle" Text="MUSIC LIBRARY" FontWeight="Bold" FontSize="12" Foreground="#C7D8C7" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><StackPanel x:Name="LibraryActions" Orientation="Horizontal"><Button Content="+ ADD FILES" Click="Add_Click" FontSize="9" Width="78"/><Button Content="ADD FOLDER" Click="AddFolder_Click" FontSize="9" Width="78"/><Button Content="REMOVE" Click="Remove_Click" FontSize="9" Width="78"/><Button Content="CLEAR" Click="Clear_Click" FontSize="9" Width="78"/><Button Content="SAVE" Click="SavePlaylist_Click" FontSize="9" Width="78"/><Button Content="LOAD" Click="LoadPlaylist_Click" FontSize="9" Width="78"/></StackPanel><TextBlock x:Name="LibraryToggleText" Text="CLOSE MUSIC LIBRARY" Foreground="#C7D8C7" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,3,0"/><Button x:Name="LibraryToggleButton" Content="−" Click="ToggleMusicLibrary_Click" Width="30" Height="26" FontSize="14" Margin="3,0,0,0" ToolTip="Collapse or expand the music library"/></StackPanel></DockPanel>
   <Grid x:Name="LibraryContent" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="130"/><ColumnDefinition Width="6"/><ColumnDefinition Width="1*" MinWidth="150"/><ColumnDefinition Width="6"/><ColumnDefinition Width="1.5*" MinWidth="180"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0A0E10" BorderBrush="#465256" BorderThickness="1" CornerRadius="3" Padding="6"><DockPanel><TextBlock DockPanel.Dock="Top" Text="FOLDERS" Foreground="#AEB7B9" FontSize="10" FontWeight="Bold" Margin="3,2,3,8" HorizontalAlignment="Center"/><ListBox x:Name="FolderList" SelectionChanged="FolderList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/></DataTemplate></ListBox.ItemTemplate><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="6,5"/><Setter Property="Margin" Value="1,3"/><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><Border x:Name="Face" CornerRadius="9" BorderThickness="1" BorderBrush="#748084"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#566164" Offset="0"/><GradientStop Color="#343E41" Offset="0.18"/><GradientStop Color="#171D20" Offset="0.52"/><GradientStop Color="#30393C" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border Margin="2" CornerRadius="7" BorderThickness="1" BorderBrush="#263034" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#C7E8C7"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#B7C7BC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#29213D" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
    <Border Grid.Column="2" Background="#0B1012" BorderBrush="#3B4548" BorderThickness="1" CornerRadius="8" Padding="6"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PLAYLISTS" Foreground="#AEB7B9" FontSize="10" FontWeight="Bold" Margin="3,2,3,8" HorizontalAlignment="Center"/><ListBox x:Name="PlaylistList" SelectionChanged="PlaylistList_SelectionChanged" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" Padding="2"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="6,5"/><Setter Property="Margin" Value="1,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><Border x:Name="Face" CornerRadius="9" BorderThickness="1" BorderBrush="#748084"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#566164" Offset="0"/><GradientStop Color="#343E41" Offset="0.18"/><GradientStop Color="#171D20" Offset="0.52"/><GradientStop Color="#30393C" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border Margin="2" CornerRadius="7" BorderThickness="1" BorderBrush="#263034" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#C7E8C7"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#B7C7BC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
    <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#29213D" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
    <Border Grid.Column="4" Background="#0B1012" BorderBrush="#3B4548" BorderThickness="1" CornerRadius="8" Padding="6"><DockPanel><TextBlock x:Name="FolderContentsTitle" DockPanel.Dock="Top" Text="TRACKS" Foreground="#AEB7B9" FontSize="10" FontWeight="Bold" Margin="3,2,3,8" HorizontalAlignment="Center"/>
     <ListBox x:Name="FolderTracks" MouseDoubleClick="FolderTracks_MouseDoubleClick" Background="Transparent" BorderThickness="0" Padding="2">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="5,0.75"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="PlayingDot" Width="10" Height="10" CornerRadius="5" Background="#39FF14" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect Color="#39FF14" BlurRadius="12" ShadowDepth="0" Opacity="1"/></Border.Effect><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Border.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger></Border.Triggers></Border><TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Normal" TextTrimming="CharacterEllipsis"><TextBlock.Effect><DropShadowEffect Color="#0D5A2A" BlurRadius="4" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0.25"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     </ListBox></DockPanel></Border>
   </Grid>
   <TextBlock Grid.Row="2" x:Name="QueueCount" Text="0 TRACKS  •  ADD A FOLDER TO BEGIN" Foreground="#9AA8A4" FontSize="9" Margin="3,10,0,0"/>
  </Grid></Border>
 </Grid>
</Window>