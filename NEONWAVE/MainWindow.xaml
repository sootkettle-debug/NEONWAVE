<Window x:Class="NEONWAVE.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NEONWAVE" Width="1040" Height="720" MinWidth="680" MinHeight="560"
 Background="#090914" Foreground="#F4F5FF" WindowStartupLocation="CenterScreen"
 AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
 KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#0C0D1B"/><Setter Property="Foreground" Value="#E9E9FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="#121326"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#302044"/><Setter Property="Foreground" Value="#5DF7FF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="13"/><Setter Property="Background" Value="#101222"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="#101222" Width="13">
     <Border Margin="3,2" CornerRadius="0" Background="#101B30" BorderBrush="#173A60" BorderThickness="1"/>
     <Track x:Name="PART_Track" IsDirectionReversed="True">
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="1,1" CornerRadius="0" BorderBrush="#258BFF" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#087BFF" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/></Border.Effect><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#06264A" Offset="0"/><GradientStop Color="#0A4778" Offset="0.5"/><GradientStop Color="#07345F" Offset="1"/></LinearGradientBrush></Border.Background></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#0A4778"/><Setter Property="Background" Value="#101B30"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EDEBFF"/><Setter Property="Background" Value="#25203B"/>
   <Setter Property="BorderBrush" Value="#FF70D8"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="3,6"/><Setter Property="FontSize" Value="9"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Margin" Value="3,0"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0A0B18" Offset="0"/><GradientStop Color="#171027" Offset="0.48"/><GradientStop Color="#10172A" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="LibraryRow" Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="N E O N W A V E" FontSize="27" FontWeight="Bold" Foreground="#36F5FF" VerticalAlignment="Center"/>
   <Border x:Name="LogoGlow" Grid.Column="1" Width="62" Height="62" CornerRadius="31" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="2" BorderBrush="#FF4BD8" Background="#17132D">
    <Border.Effect><DropShadowEffect Color="#FF32D2" BlurRadius="24" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
    <Border CornerRadius="29" Margin="3" BorderThickness="1" BorderBrush="#54F7FF">
     <Border.Background><RadialGradientBrush><GradientStop Color="#4B1F68" Offset="0"/><GradientStop Color="#201A49" Offset="0.58"/><GradientStop Color="#10172C" Offset="1"/></RadialGradientBrush></Border.Background>
     <Border.Effect><DropShadowEffect Color="#36F5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.75"/></Border.Effect>
     <Viewbox Margin="7"><Grid Width="50" Height="50">
       <Path Data="M 25,25 C 24,30 23,35 22,40 C 21,42 21,43 20,44" Stroke="#FF8A24" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Effect><DropShadowEffect Color="#FF781E" BlurRadius="8" ShadowDepth="0" Opacity="1"/></Path.Effect></Path>
       <Path Data="M 25,25 C 17,22 10,18 7,12 C 15,12 22,15 25,22 C 22,14 23,7 27,4 C 31,10 31,17 27,23 C 32,16 39,13 45,14 C 42,21 35,25 27,26 C 35,24 42,26 46,31 C 38,34 31,31 26,27" Stroke="#63FF55" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"><Path.Effect><DropShadowEffect Color="#36FF55" BlurRadius="9" ShadowDepth="0" Opacity="1"/></Path.Effect></Path>
       <Path Data="M 5,43 C 13,38 20,40 26,43 C 33,46 39,43 46,39" Stroke="#36CFFF" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Effect><DropShadowEffect Color="#16BFFF" BlurRadius="9" ShadowDepth="0" Opacity="1"/></Path.Effect></Path>
      </Grid></Viewbox>
    </Border>
   </Border>
  </Grid>
  <Border Grid.Row="1" Background="#17152A" BorderBrush="#493052" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="NOW TRANSMITTING" Foreground="#FF3BC8" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TrackTitle" Text="No track loaded" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="TrackInfo" Text="Add an audio folder or drop music files here" Foreground="#8586A8" FontSize="11" Margin="0,3,0,0"/></StackPanel><Border HorizontalAlignment="Right" Width="76" Height="76" CornerRadius="10" Background="#1C1D36" BorderBrush="#36F5FF" BorderThickness="1"><Viewbox><TextBlock Text="♫" Foreground="#36F5FF" FontSize="44"/></Viewbox></Border></Grid>
    <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#8586A8" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Margin="12,0" VerticalAlignment="Center" Foreground="#0A4778" Background="#101B30" ValueChanged="SeekSlider_ValueChanged" PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="#8586A8" FontSize="10" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="2" Background="#17152A" BorderBrush="#493052" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="NEONWAVE  •  READY TO PLAY" Foreground="#77799E" FontSize="9" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="|◀" Click="Previous_Click" FontSize="9" Width="78"/><Button x:Name="PlayButton" Content="▶" Click="Play_Click" FontSize="9" Width="78" Background="#24264A"/><Button Content="■" Click="Stop_Click" FontSize="9" Width="78"/><Button Content="▶|" Click="Next_Click" FontSize="9" Width="78"/></StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="VolumeText" Text="80%" Foreground="#36F5FF" FontSize="10" HorizontalAlignment="Right"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" Width="120" ValueChanged="VolumeSlider_ValueChanged"/></StackPanel>
     </Grid>
    </Border>
   </Grid>
  </Border>
  <Border x:Name="MusicLibraryPanel" Grid.Row="2" Background="#141629" BorderBrush="#34304F" BorderThickness="1" CornerRadius="12" Padding="14">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel x:Name="LibraryHeader" Margin="0,0,0,10">
     <TextBlock Text="MUSIC LIBRARY" FontWeight="Bold" FontSize="12" Foreground="#36F5FF" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><StackPanel x:Name="LibraryActions" Orientation="Horizontal"><Button Content="+ ADD FILES" Click="Add_Click" FontSize="9" Width="78"/><Button Content="ADD FOLDER" Click="AddFolder_Click" FontSize="9" Width="78"/><Button Content="REMOVE" Click="Remove_Click" FontSize="9" Width="78"/><Button Content="CLEAR" Click="Clear_Click" FontSize="9" Width="78"/><Button Content="SAVE" Click="SavePlaylist_Click" FontSize="9" Width="78"/><Button Content="LOAD" Click="LoadPlaylist_Click" FontSize="9" Width="78"/></StackPanel><TextBlock x:Name="LibraryToggleText" Text="CLOSE MUSIC LIBRARY" Foreground="#36F5FF" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,3,0"/><Button x:Name="LibraryToggleButton" Content="−" Click="ToggleMusicLibrary_Click" Width="30" Height="26" FontSize="14" Margin="3,0,0,0" ToolTip="Collapse or expand the music library"/></StackPanel>
    </DockPanel>
    <Grid x:Name="LibraryContent" Grid.Row="1">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.85*" MinWidth="130"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="1*" MinWidth="150"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="1.5*" MinWidth="180"/>
     </Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="#0D1020" BorderBrush="#34304F" BorderThickness="1" CornerRadius="8" Padding="6">
      <DockPanel><TextBlock DockPanel.Dock="Top" Text="FOLDERS" Foreground="#FF70D8" FontSize="10" FontWeight="Bold" Margin="7,5,4,8"/><ListBox x:Name="FolderList" SelectionChanged="FolderList_SelectionChanged" DisplayMemberPath="Name">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
         <Setter Property="Foreground" Value="#36F5FF"/><Setter Property="Background" Value="#10182A"/><Setter Property="BorderBrush" Value="#183B55"/><Setter Property="BorderThickness" Value="1"/>
         <Setter Property="Padding" Value="3,3"/><Setter Property="Margin" Value="0,1"/><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
         <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FF4BD8"/><Setter Property="Background" Value="#29152F"/><Setter Property="BorderBrush" Value="#FF3BC8"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF3BC8" BlurRadius="12" ShadowDepth="0" Opacity="0.65"/></Setter.Value></Setter></Trigger></Style.Triggers>
        </Style></ListBox.ItemContainerStyle>
      </ListBox></DockPanel>
     </Border>
     <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#29213D" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
     <Border Grid.Column="2" Background="#0D1020" BorderBrush="#34304F" BorderThickness="1" CornerRadius="8" Padding="6">
      <DockPanel><TextBlock DockPanel.Dock="Top" Text="PLAYLISTS" Foreground="#B78CFF" FontSize="10" FontWeight="Bold" Margin="7,5,4,8"/>
       <ListBox x:Name="PlaylistList" SelectionChanged="PlaylistList_SelectionChanged" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" Padding="2">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#C8B8FF"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,4"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#36F5FF"/><Setter Property="Background" Value="#18283A"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
       </ListBox>
      </DockPanel>
     </Border>
     <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#29213D" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
     <Border Grid.Column="4" Background="#0D1020" BorderBrush="#34304F" BorderThickness="1" CornerRadius="8" Padding="6">
      <DockPanel><TextBlock DockPanel.Dock="Top" x:Name="FolderContentsTitle" Text="TRACKS" Foreground="#36F5FF" FontSize="10" FontWeight="Bold" Margin="7,3,4,5"/><ListBox x:Name="FolderTracks" MouseDoubleClick="FolderTracks_MouseDoubleClick" DisplayMemberPath="DisplayName" Background="Transparent" BorderThickness="0" Padding="2"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#E9E9FA"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4,2"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox></DockPanel>
     </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="QueueCount" Text="0 TRACKS  •  ADD A FOLDER TO BEGIN" Foreground="#8586A8" FontSize="9" Margin="3,10,0,0"/>
   </Grid>
  </Border>
 </Grid>
</Window>