<Window x:Class="NEONWAVE.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NEONWAVE" Width="1040" Height="720" MinWidth="780" MinHeight="600"
 Background="#090914" Foreground="#F4F5FF" WindowStartupLocation="CenterScreen"
 AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
 KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#0C0D1B"/><Setter Property="Foreground" Value="#E9E9FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="#121326"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#36F5FF"/></Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="N E O N W A V E" FontSize="27" FontWeight="Bold" Foreground="#36F5FF"/>
    <TextBlock Text="S Y N T H W A V E   A U D I O   S Y S T E M" FontSize="10" Foreground="#8586A8" Margin="2,4,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="●" Foreground="#FF3BC8" FontSize="12" VerticalAlignment="Center"/>
    <TextBlock Text="  AUDIO CORE ONLINE" Foreground="#A7A8C5" FontSize="10" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#111222" BorderBrush="#282A46" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <StackPanel>
      <TextBlock Text="NOW TRANSMITTING" Foreground="#FF3BC8" FontSize="10" FontWeight="Bold"/>
      <TextBlock x:Name="TrackTitle" Text="No track loaded" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
      <TextBlock x:Name="TrackInfo" Text="Drop MP3 files here or add music to begin" Foreground="#8586A8" FontSize="11" Margin="0,3,0,0"/>
     </StackPanel>
     <Border HorizontalAlignment="Right" Width="76" Height="76" CornerRadius="10" Background="#1C1D36" BorderBrush="#36F5FF" BorderThickness="1">
      <Viewbox><TextBlock Text="♫" Foreground="#36F5FF" FontSize="44"/></Viewbox>
     </Border>
    </Grid>
    <UniformGrid x:Name="Spectrum" Grid.Row="1" Rows="1" Margin="0,12,0,8" VerticalAlignment="Stretch"/>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#8586A8" FontSize="10" VerticalAlignment="Center"/>
     <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Margin="12,0" VerticalAlignment="Center" ValueChanged="SeekSlider_ValueChanged"/>
     <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="#8586A8" FontSize="10" VerticalAlignment="Center"/>
    </Grid>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#111222" BorderBrush="#282A46" BorderThickness="1" CornerRadius="12" Padding="14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10">
      <TextBlock Text="PLAY QUEUE" FontWeight="Bold" FontSize="12" Foreground="#36F5FF" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <Button Content="+ ADD" Click="Add_Click" FontSize="10"/>
       <Button Content="SAVE" Click="SavePlaylist_Click" FontSize="10"/>
       <Button Content="LOAD" Click="LoadPlaylist_Click" FontSize="10"/>
      </StackPanel>
     </DockPanel>
     <ListBox x:Name="Playlist" Grid.Row="1" SelectionChanged="Playlist_SelectionChanged" MouseDoubleClick="Playlist_MouseDoubleClick" DisplayMemberPath="DisplayName"/>
     <TextBlock Grid.Row="2" x:Name="QueueCount" Text="0 TRACKS  •  DROP FILES TO ADD" Foreground="#8586A8" FontSize="9" Margin="3,10,0,0"/>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="#111222" BorderBrush="#282A46" BorderThickness="1" CornerRadius="12" Padding="14">
    <StackPanel>
     <TextBlock Text="SIGNAL CONTROLS" FontWeight="Bold" FontSize="12" Foreground="#FF3BC8" Margin="0,0,0,14"/>
     <TextBlock Text="MASTER OUTPUT" Foreground="#8586A8" FontSize="10"/>
     <DockPanel Margin="0,4,0,16">
      <TextBlock x:Name="VolumeText" Text="80%" Width="38" Foreground="#36F5FF" VerticalAlignment="Center"/>
      <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeSlider_ValueChanged"/>
     </DockPanel>
     <TextBlock Text="10-BAND EQUALIZER" Foreground="#8586A8" FontSize="10" Margin="0,0,0,8"/>
     <UniformGrid x:Name="EqualizerPanel" Columns="2"/>
     <Button Content="RESET EQ" Click="ResetEq_Click" Margin="0,14,0,0"/>
     <TextBlock Text="SPACE  PLAY / PAUSE&#10;← →  SEEK 5 SECONDS&#10;CTRL + O  ADD MUSIC" Foreground="#8586A8" FontSize="10" LineHeight="19" Margin="2,18,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#111222" BorderBrush="#282A46" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,14,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="＋ ADD TRACKS" Click="Add_Click" Foreground="#36F5FF"/>
     <Button Content="REMOVE" Click="Remove_Click"/>
     <Button Content="CLEAR" Click="Clear_Click"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
     <Button Content="|◀" Click="Previous_Click" FontSize="16" Width="48"/>
     <Button x:Name="PlayButton" Content="▶" Click="Play_Click" FontSize="20" Width="64" Background="#24264A" BorderBrush="#36F5FF"/>
     <Button Content="■" Click="Stop_Click" FontSize="16" Width="48"/>
     <Button Content="▶|" Click="Next_Click" FontSize="16" Width="48"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="NEONWAVE  /  01" Foreground="#8586A8" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
   </Grid>
  </Border>
 </Grid>
</Window>