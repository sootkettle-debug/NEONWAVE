<Application x:Class="NEONWAVE.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#090914"/>
  <SolidColorBrush x:Key="Panel" Color="#111222"/>
  <SolidColorBrush x:Key="Cyan" Color="#36F5FF"/>
  <SolidColorBrush x:Key="Pink" Color="#FF3BC8"/>
  <SolidColorBrush x:Key="Muted" Color="#8586A8"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F4F5FF"/>
   <Setter Property="Background" Value="#20213A"/>
   <Setter Property="BorderBrush" Value="#343653"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#F4F5FF"/>
  </Style>
 </Application.Resources>
</Application>